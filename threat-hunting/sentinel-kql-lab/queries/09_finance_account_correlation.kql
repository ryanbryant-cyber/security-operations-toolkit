let FinanceSigninFailures =
    SigninLogs
    | where TimeGenerated between (
        datetime(2026-09-23T12:00:00Z)
        ..
        datetime(2026-09-23T13:00:00Z)
    )
    | where UserPrincipalName =~ "finance.user@northstar.example"
    | where tostring(ResultType) != "0"
    | summarize
        FailedAttempts = count(),
        FirstFailure = min(TimeGenerated),
        LastFailure = max(TimeGenerated)
        by UserPrincipalName, IPAddress
    | where FailedAttempts >= 3;

let FinanceSuccess =
    SigninLogs
    | where TimeGenerated between (
        datetime(2026-09-23T12:00:00Z)
        ..
        datetime(2026-09-23T13:00:00Z)
    )
    | where UserPrincipalName =~ "finance.user@northstar.example"
    | where tostring(ResultType) == "0"
    | extend AccountName = tostring(
        split(UserPrincipalName, "@")[0]
    )
    | project
        AccountName,
        UserPrincipalName,
        SuccessTime = TimeGenerated,
        SuccessIP = IPAddress,
        AppDisplayName,
        Location,
        ConditionalAccessStatus,
        DeviceCompliant;

let FinanceProcesses =
    ProcessEvents
    | where TimeGenerated between (
        datetime(2026-09-23T12:00:00Z)
        ..
        datetime(2026-09-23T13:00:00Z)
    )
    | where AccountName =~ "finance.user"
    | where ProcessName in~ (
        "powershell.exe",
        "cmd.exe"
    )
    | project
        AccountName,
        ProcessTime = TimeGenerated,
        DeviceName,
        ProcessName,
        ParentProcessName,
        CommandLine,
        ProcessSeverity = Severity,
        ProcessDescription = Description;

let FinanceNetwork =
    NetworkEvents
    | where TimeGenerated between (
        datetime(2026-09-23T12:00:00Z)
        ..
        datetime(2026-09-23T13:00:00Z)
    )
    | where AccountName =~ "finance.user"
    | project
        AccountName,
        NetworkTime = TimeGenerated,
        DeviceName,
        SourceIP,
        DestinationIP,
        DestinationPort,
        Action,
        Direction,
        NetworkDescription = Description;

FinanceSigninFailures
| join kind=inner FinanceSuccess
    on UserPrincipalName
| where IPAddress == SuccessIP
| extend SecondsFailureToSuccess =
    datetime_diff(
        "second",
        SuccessTime,
        LastFailure
    )
| where SecondsFailureToSuccess between (0 .. 300)
| join kind=inner FinanceProcesses
    on AccountName
| extend SecondsSuccessToProcess =
    datetime_diff(
        "second",
        ProcessTime,
        SuccessTime
    )
| where SecondsSuccessToProcess between (0 .. 300)
| join kind=inner FinanceNetwork
    on AccountName
| extend SecondsProcessToNetwork =
    datetime_diff(
        "second",
        NetworkTime,
        ProcessTime
    )
| where SecondsProcessToNetwork between (0 .. 300)
| project
    UserPrincipalName,
    SuccessIP,
    FailedAttempts,
    FirstFailure,
    LastFailure,
    SuccessTime,
    SecondsFailureToSuccess,
    ProcessTime,
    DeviceName,
    ProcessName,
    CommandLine,
    SecondsSuccessToProcess,
    NetworkTime,
    DestinationIP,
    DestinationPort,
    Action,
    NetworkDescription,
    SecondsProcessToNetwork,
    ConditionalAccessStatus,
    DeviceCompliant
| order by ProcessTime asc
