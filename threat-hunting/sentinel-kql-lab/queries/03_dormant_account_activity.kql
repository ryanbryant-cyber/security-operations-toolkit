SigninLogs
| where TimeGenerated between (
    datetime(2026-09-23T12:00:00Z)
    ..
    datetime(2026-09-23T13:00:00Z)
)
| where AccountStatus =~ "dormant"
| project
    TimeGenerated,
    UserPrincipalName,
    IPAddress,
    AppDisplayName,
    Location,
    ConditionalAccessStatus,
    DeviceCompliant,
    ResultType,
    ResultDescription
| order by TimeGenerated asc
