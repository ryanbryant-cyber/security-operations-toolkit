let FailedSignins =
    SigninLogs
    | where TimeGenerated between (
        datetime(2026-09-23T12:00:00Z)
        ..
        datetime(2026-09-23T13:00:00Z)
    )
    | where tostring(ResultType) != "0"
    | summarize
        FailedAttempts = count(),
        FirstFailure = min(TimeGenerated),
        LastFailure = max(TimeGenerated)
        by UserPrincipalName, IPAddress
    | where FailedAttempts >= 3;

let SuccessfulSignins =
    SigninLogs
    | where TimeGenerated between (
        datetime(2026-09-23T12:00:00Z)
        ..
        datetime(2026-09-23T13:00:00Z)
    )
    | where tostring(ResultType) == "0"
    | project
        SuccessTime = TimeGenerated,
        UserPrincipalName,
        IPAddress,
        AppDisplayName,
        Location,
        ConditionalAccessStatus,
        DeviceCompliant;

FailedSignins
| join kind=inner SuccessfulSignins
    on UserPrincipalName, IPAddress
| extend SecondsAfterLastFailure =
    datetime_diff(
        "second",
        SuccessTime,
        LastFailure
    )
| where SecondsAfterLastFailure between (0 .. 300)
| project
    UserPrincipalName,
    IPAddress,
    FailedAttempts,
    FirstFailure,
    LastFailure,
    SuccessTime,
    SecondsAfterLastFailure,
    AppDisplayName,
    Location,
    ConditionalAccessStatus,
    DeviceCompliant
| order by SuccessTime asc
