let DormantSignins =
    SigninLogs
    | where TimeGenerated between (
        datetime(2026-09-23T12:00:00Z)
        ..
        datetime(2026-09-23T13:00:00Z)
    )
    | where AccountStatus =~ "dormant"
    | where tostring(ResultType) == "0"
    | extend AccountName = tostring(
        split(UserPrincipalName, "@")[0]
    )
    | project
        AccountName,
        UserPrincipalName,
        SigninTime = TimeGenerated,
        SigninIP = IPAddress,
        AppDisplayName,
        Location,
        ConditionalAccessStatus,
        DeviceCompliant;

let SuspiciousPowerShell =
    ProcessEvents
    | where TimeGenerated between (
        datetime(2026-09-23T12:00:00Z)
        ..
        datetime(2026-09-23T13:00:00Z)
    )
    | where ProcessName =~ "powershell.exe"
    | where CommandLine has_any (
        "-EncodedCommand",
        "-enc",
        "-ExecutionPolicy Bypass"
    )
    | project
        AccountName,
        ProcessTime = TimeGenerated,
        DeviceName,
        CommandLine,
        ProcessSeverity = Severity,
        ProcessDescription = Description;

let PrivilegedRoleChanges =
    PrivilegedActivity
    | where TimeGenerated between (
        datetime(2026-09-23T12:00:00Z)
        ..
        datetime(2026-09-23T13:00:00Z)
    )
    | where ActivityStatus =~ "Success"
    | where RoleName =~ "Contributor"
    | extend AccountName = tostring(
        split(TargetUser, "@")[0]
    )
    | project
        AccountName,
        RoleTime = TimeGenerated,
        InitiatedBy,
        TargetUser,
        OperationName,
        RoleName,
        RoleIPAddress = IPAddress,
        Justification,
        TicketNumber,
        RoleDescription = Description;

DormantSignins
| join kind=inner SuspiciousPowerShell
    on AccountName
| extend SecondsSigninToProcess =
    datetime_diff(
        "second",
        ProcessTime,
        SigninTime
    )
| where SecondsSigninToProcess between (0 .. 300)
| join kind=inner PrivilegedRoleChanges
    on AccountName
| extend SecondsProcessToRole =
    datetime_diff(
        "second",
        RoleTime,
        ProcessTime
    )
| where SecondsProcessToRole between (0 .. 300)
| project
    UserPrincipalName,
    AccountName,
    SigninTime,
    SigninIP,
    ProcessTime,
    DeviceName,
    CommandLine,
    SecondsSigninToProcess,
    RoleTime,
    RoleName,
    OperationName,
    RoleIPAddress,
    Justification,
    TicketNumber,
    SecondsProcessToRole,
    ConditionalAccessStatus,
    DeviceCompliant
| order by SigninTime asc
